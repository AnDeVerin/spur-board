{
  "name": "spur-board-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=24.12"
  },
  "scripts": {
    "agents:sync": "node scripts/agents.ts sync",
    "check": "node scripts/check.ts",
    "check:full": "node scripts/check.ts --full",
    "ci:changes": "node scripts/ci.ts changes",
    "ci:secrets-range": "node scripts/ci.ts secrets-range",
    "ci:ok": "node scripts/ci.ts ok",
    "ci:status": "node scripts/ci-status.ts",
    "format": "prettier --write .",
    "gen": "pnpm gen:config-schema && pnpm gen:ops-snapshot && pnpm gen:skill && pnpm gen:docs",
    "gen:config-schema": "node scripts/gen-config-schema.ts",
    "gen:docs": "node scripts/gen-docs.ts && node scripts/gen-errors-docs.ts",
    "gen:ops-snapshot": "node scripts/gen-ops-snapshot.ts",
    "gen:skill": "node scripts/gen-skill.ts",
    "guardrails": "node scripts/guardrails.ts",
    "lint": "eslint . --max-warnings=0",
    "lint:agents": "node scripts/agents.ts lint",
    "package:build": "node scripts/package.ts build",
    "package:pack": "node scripts/package.ts pack",
    "package:check": "node scripts/package.ts check",
    "package:smoke": "node scripts/package-smoke.ts",
    "record:fakes": "node packages/stand/src/record.ts",
    "smoke:live": "node scripts/smoke-live.ts",
    "stand": "node packages/stand/src/cli.ts",
    "upgrade:smoke": "node scripts/upgrade-smoke.ts",
    "update:smoke": "node scripts/update-smoke.ts",
    "prepare": "node scripts/hooks.ts install",
    "typecheck": "tsc --noEmit -p . && pnpm -r typecheck",
    "test": "vitest run"
  },
  "devDependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "catalog:",
    "@semantic-release/changelog": "catalog:",
    "@semantic-release/commit-analyzer": "catalog:",
    "@semantic-release/github": "catalog:",
    "@semantic-release/npm": "catalog:",
    "@semantic-release/release-notes-generator": "catalog:",
    "@stryker-mutator/core": "catalog:",
    "@stryker-mutator/vitest-runner": "catalog:",
    "@types/node": "catalog:",
    "@typescript/native": "catalog:",
    "@vitest/eslint-plugin": "catalog:",
    "conventional-changelog-conventionalcommits": "catalog:",
    "eslint": "catalog:",
    "knip": "catalog:",
    "prettier": "catalog:",
    "semantic-release": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vitest": "catalog:",
    "yaml": "catalog:"
  }
}
