{
  "name": "@spur-board/daemon",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/main.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p .",
    "daemon": "node src/main.ts",
    "daemon:dev": "node src/main.ts | pino-pretty"
  },
  "dependencies": {
    "@spur-board/adapters": "workspace:*",
    "@spur-board/contracts": "workspace:*",
    "@spur-board/core": "workspace:*",
    "@spur-board/gateway-slack": "workspace:*",
    "pino": "catalog:",
    "yaml": "catalog:"
  },
  "devDependencies": {
    "@spur-board/gateway-testkit": "workspace:*",
    "pino-pretty": "catalog:"
  }
}
