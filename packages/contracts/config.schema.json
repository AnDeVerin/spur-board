{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "projects": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
          "tracker": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "type": { "type": "string", "const": "jira" },
                  "baseUrl": { "type": "string", "format": "uri" },
                  "jql": { "type": "string", "minLength": 1 },
                  "doneStatuses": {
                    "minItems": 1,
                    "type": "array",
                    "items": { "type": "string", "minLength": 1 }
                  },
                  "readyStatuses": {
                    "minItems": 1,
                    "type": "array",
                    "items": { "type": "string", "minLength": 1 }
                  },
                  "projectKeys": {
                    "default": [],
                    "type": "array",
                    "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" }
                  }
                },
                "required": ["type", "baseUrl", "jql", "doneStatuses", "readyStatuses"],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "type": { "type": "string", "const": "github-issues" },
                  "repo": { "type": "string", "pattern": "^[A-Za-z0-9-]+\\/[A-Za-z0-9._-]+$" },
                  "label": { "type": "string", "minLength": 1 },
                  "milestone": { "type": "string", "minLength": 1 },
                  "branchPattern": {
                    "default": "^[A-Za-z][A-Za-z0-9]*-([1-9][0-9]{0,14})(?:-|$)",
                    "description": "Regular expression whose one capture group reads the issue number from a PR head branch, such as <agent>-<number>-<slug>. Used only when the PR has no closing issue reference in the tracker repository; PRs to a non-default base branch rely on it.",
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": ["type", "repo"],
                "additionalProperties": false
              }
            ]
          },
          "repos": {
            "minItems": 1,
            "type": "array",
            "items": { "type": "string", "pattern": "^[A-Za-z0-9-]+\\/[A-Za-z0-9._-]+$" }
          },
          "operatorGithubLogin": { "type": "string", "pattern": "^[A-Za-z0-9-]{1,39}$" },
          "spurProjects": {
            "default": [],
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": { "type": "string", "minLength": 1 },
                "role": { "type": "string", "enum": ["worker", "operator"] }
              },
              "required": ["name", "role"],
              "additionalProperties": false
            }
          },
          "columns": {
            "default": [
              { "id": "todo", "enabled": true, "orchestrator": "none" },
              { "id": "ready-for-dev", "enabled": true, "orchestrator": "none" },
              { "id": "dev", "enabled": true, "orchestrator": "none" },
              { "id": "review", "enabled": true, "orchestrator": "none" },
              { "id": "qa", "enabled": true, "orchestrator": "none" },
              { "id": "ready-to-merge", "enabled": true, "orchestrator": "none" },
              { "id": "done", "enabled": true, "orchestrator": "none" }
            ],
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "enum": ["todo", "ready-for-dev", "dev", "review", "qa", "ready-to-merge", "done"]
                },
                "enabled": { "default": true, "type": "boolean" },
                "orchestrator": { "default": "none", "type": "string", "minLength": 1 }
              },
              "required": ["id"],
              "additionalProperties": false
            }
          }
        },
        "required": ["id", "tracker", "repos", "operatorGithubLogin"],
        "additionalProperties": false
      }
    },
    "operator": {
      "type": "object",
      "properties": { "slack": { "type": "string", "minLength": 1 } },
      "required": ["slack"],
      "additionalProperties": false
    },
    "slack": {
      "default": {},
      "type": "object",
      "properties": {
        "appName": { "default": "spur-board", "type": "string", "minLength": 1 },
        "command": { "default": "/board", "type": "string", "pattern": "^\\/[a-z0-9_-]+$" },
        "appId": { "type": "string", "pattern": "^A[A-Z0-9]+$" },
        "channels": {
          "default": {},
          "type": "object",
          "properties": {
            "orchestrators": { "type": "string", "minLength": 1 },
            "feed": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "thresholds": {
      "default": {},
      "type": "object",
      "properties": {
        "staleMultiplier": { "default": 3, "type": "number", "minimum": 1 },
        "blockOpenMs": {
          "default": 86400000,
          "description": "How long a block may stay open before an item is raised in milliseconds.",
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "additionalProperties": false
    },
    "archive": {
      "default": {},
      "type": "object",
      "properties": {
        "doneWeekday": {
          "default": "saturday",
          "type": "string",
          "enum": ["monday", "tuesday", "wednesday", "thursday", "friday", "saturday", "sunday"]
        }
      },
      "additionalProperties": false
    },
    "digest": {
      "type": "object",
      "properties": { "tz": { "type": "string" } },
      "required": ["tz"],
      "additionalProperties": false
    },
    "commands": {
      "default": {},
      "type": "object",
      "properties": {
        "retentionDays": {
          "default": 7,
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "additionalProperties": false
    },
    "doorbells": {
      "default": {},
      "type": "object",
      "properties": {
        "firstRetryMs": {
          "default": 120000,
          "description": "Wait after the first unanswered doorbell in milliseconds.",
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "secondRetryMs": {
          "default": 300000,
          "description": "Wait after the second unanswered doorbell in milliseconds.",
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "unansweredAfterMs": {
          "default": 900000,
          "description": "Wait after the third unanswered doorbell in milliseconds.",
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "additionalProperties": false
    },
    "http": {
      "default": {},
      "type": "object",
      "properties": {
        "port": {
          "default": 4311,
          "description": "Local HTTP API port (0 assigns a free port).",
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        }
      },
      "additionalProperties": false
    },
    "adapters": {
      "default": {},
      "type": "object",
      "properties": {
        "spur": {
          "default": {},
          "type": "object",
          "properties": {
            "intervalMs": {
              "default": 15000,
              "description": "Time between two polls in milliseconds.",
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "baseUrl": {
              "default": "http://127.0.0.1:4310",
              "description": "Base URL of the local Spur HTTP API.",
              "type": "string",
              "format": "uri"
            }
          },
          "additionalProperties": false
        },
        "github": {
          "default": {},
          "type": "object",
          "properties": {
            "intervalMs": {
              "default": 60000,
              "description": "Time between two polls in milliseconds.",
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            }
          },
          "additionalProperties": false
        },
        "jira": {
          "default": {},
          "type": "object",
          "properties": {
            "intervalMs": {
              "default": 120000,
              "description": "Time between two polls in milliseconds.",
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "sources": {
      "default": {},
      "type": "object",
      "properties": {
        "authRetryMs": {
          "default": 900000,
          "description": "Wait before polling a source again after an auth error in milliseconds.",
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "goneAfterPolls": {
          "default": 3,
          "description": "Complete polls an entity must be missing from before it counts as gone.",
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "additionalProperties": false
    },
    "github": {
      "default": {},
      "type": "object",
      "properties": {
        "reserveRemaining": {
          "default": 1000,
          "description": "GitHub API requests to leave unused in each quota window.",
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "additionalProperties": false
    },
    "health": {
      "default": {},
      "type": "object",
      "properties": {
        "errorAfterMs": {
          "default": 90000,
          "description": "How long a session stays in error before it is flagged in milliseconds.",
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "needsInputAfterMs": {
          "default": 120000,
          "description": "How long a session waits for input before it is flagged in milliseconds.",
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "idleInDevAfterMs": {
          "default": 1800000,
          "description": "How long a worker session without an open PR waits at its prompt before it is flagged in milliseconds.",
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "flipSmoothingMs": {
          "default": 30000,
          "description": "How long a new session health value must hold before it is reported in milliseconds.",
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "hostLoad": {
          "default": {},
          "type": "object",
          "properties": {
            "sessions": {
              "default": 3,
              "description": "Sessions entering error within the window that start an episode.",
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "windowMs": {
              "default": 60000,
              "description": "Window in which that many sessions entering error start a host-load episode in milliseconds.",
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "maxEpisodeMs": {
              "default": 300000,
              "description": "Longest a host-load episode lasts before error flags resume in milliseconds.",
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "required": ["projects", "operator", "digest"],
  "additionalProperties": false
}
