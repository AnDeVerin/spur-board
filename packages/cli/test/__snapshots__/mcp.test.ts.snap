        {
          "additionalProperties": false,
          "description": "Unblock with a reason.",
          "properties": {
            "block": {
              "description": "Block ID: B followed by a number, e.g. B12.",
              "pattern": "^B[1-9]\\d{0,14}$",
              "type": "string",
            },
            "idempotencyKey": {
              "description": "Key to reuse when retrying this action.",
              "minLength": 1,
              "type": "string",
            },
            "mode": {
              "const": "reason",
              "description": "Unblock with an explanation.",
              "type": "string",
            },
            "reason": {
              "description": "Why the block no longer applies.",
              "minLength": 1,
              "type": "string",
            },
          },
          "required": [
            "mode",
            "block",
            "reason",
          ],
          "type": "object",
        },
        {
          "additionalProperties": false,
          "description": "Withdraw the block.",
          "properties": {
            "answer": {
              "description": "Answer received outside the board.",
              "minLength": 1,
              "type": "string",
            },
            "block": {
              "description": "Block ID: B followed by a number, e.g. B12.",
              "pattern": "^B[1-9]\\d{0,14}$",
              "type": "string",
            },
            "idempotencyKey": {
              "description": "Key to reuse when retrying this action.",
              "minLength": 1,
              "type": "string",
            },
            "mode": {
              "const": "withdraw",
              "description": "The author takes their own question back (needs_input only).",
