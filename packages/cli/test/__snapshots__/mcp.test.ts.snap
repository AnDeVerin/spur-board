    "execution": undefined,
    "icons": undefined,
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "role": {
          "description": "Limit the answer to operations this role may call.",
          "enum": [
            "operator",
            "worker",
            "orchestrator",
          ],
          "type": "string",
        },
      },
      "type": "object",
    },
    "name": "schema_get",
    "outputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "The operation catalog.",
      "properties": {
        "operations": {
          "description": "Operations the caller may use.",
          "items": {
            "additionalProperties": false,
            "description": "One operation.",
            "properties": {
              "cli": {
                "additionalProperties": false,
                "description": "CLI binding.",
                "properties": {
                  "args": {
                    "description": "Input fields given as positional arguments.",
                    "items": {
                      "type": "string",
                    },
                    "type": "array",
                  },
                  "command": {
                    "description": "CLI command after \`board\`.",
                    "type": "string",
                  },
                  "key": {
                    "anyOf": [
                      {
                        "const": "--key",
                        "type": "string",
                      },
                      {
                        "type": "null",
                      },
                    ],
                    "description": "Idempotency key flag; null for a query.",
                  },
                  "modes": {
                    "anyOf": [
                      {
                        "items": {
                          "additionalProperties": false,
                          "description": "A CLI flag that picks one input mode.",
                          "properties": {
                            "flag": {
                              "description": "CLI flag that picks the branch, e.g. --done.",
                              "pattern": "^--[a-z][a-z-]*$",
                              "type": "string",
                            },
                            "mode": {
                              "description": "Branch of the input \`mode\` discriminator the flag picks.",
                              "minLength": 1,
                              "type": "string",
                            },
                            "value": {
                              "anyOf": [
                                {
                                  "minLength": 1,
                                  "type": "string",
                                },
                                {
                                  "type": "null",
                                },
                              ],
                              "description": "Input field the flag value fills; null for a flag without a value.",
                            },
                          },
                          "required": [
                            "mode",
                            "flag",
                            "value",
                          ],
                          "type": "object",
                        },
                        "minItems": 1,
                        "type": "array",
                      },
                      {
                        "type": "null",
                      },
                    ],
                    "description": "Flags that pick a branch of a union input; null for a plain input.",
                  },
                },
                "required": [
                  "command",
                  "args",
                  "modes",
                  "key",
                ],
                "type": "object",
              },
              "description": {
                "description": "What the operation does.",
                "type": "string",
              },
              "errors": {
                "description": "Error codes the operation can return.",
                "items": {
                  "type": "string",
                },
                "type": "array",
              },
              "grants": {
                "anyOf": [
                  {
                    "const": "any",
                    "type": "string",
                  },
                  {
                    "items": {
                      "additionalProperties": false,
                      "description": "A grant rule: who may call the operation, optionally for one mode or block type.",
                      "properties": {
                        "blockTypes": {
                          "description": "Block types the rule applies to; absent means every type.",
                          "items": {
                            "enum": [
                              "code",
                              "needs_input",
                              "dependency",
                              "external",
                            ],
                            "type": "string",
                          },
                          "minItems": 1,
                          "type": "array",
                        },
                        "grant": {
                          "description": "Who the rule admits.",
                          "enum": [
                            "operator",
                            "project-agent",
                            "task-worker",
                            "column-orchestrator",
                            "block-addressee",
                            "block-author",
                          ],
                          "type": "string",
                        },
                        "mode": {
                          "description": "Input mode the rule applies to; absent means every mode.",
                          "minLength": 1,
                          "type": "string",
                        },
                      },
                      "required": [
                        "grant",
                      ],
                      "type": "object",
                    },
                    "minItems": 1,
                    "type": "array",
                  },
                ],
                "description": "Who may call it: any identified caller, or the listed rules.",
              },
              "id": {
                "description": "Operation ID, e.g. task.get.",
                "type": "string",
              },
              "inputSchema": {
                "additionalProperties": {},
                "description": "JSON Schema of the input.",
                "propertyNames": {
                  "type": "string",
                },
                "type": "object",
              },
              "kind": {
                "description": "query reads; mutation changes state.",
                "enum": [
                  "query",
                  "mutation",
                ],
                "type": "string",
              },
              "mcp": {
                "additionalProperties": false,
                "description": "MCP binding.",
                "properties": {
                  "key": {
                    "anyOf": [
                      {
                        "const": "idempotencyKey",
                        "type": "string",
                      },
                      {
                        "type": "null",
                      },
                    ],
                    "description": "Idempotency key argument; null for a query.",
                  },
                  "name": {
                    "description": "MCP tool name.",
                    "type": "string",
                  },
                  "whenNotToUse": {
                    "description": "When to use a neighboring tool instead.",
                    "minLength": 1,
                    "type": "string",
                  },
                  "whenToUse": {
                    "description": "When this MCP tool is appropriate.",
                    "minLength": 1,
                    "type": "string",
                  },
                },
                "required": [
                  "name",
                  "key",
                  "whenToUse",
                  "whenNotToUse",
                ],
                "type": "object",
              },
              "outputSchema": {
                "additionalProperties": {},
                "description": "JSON Schema of the output.",
