                "needs_input",
                "dependency",
                "external",
              ],
              "type": "string",
            },
            "unblockedAt": {
              "anyOf": [
                {
                  "format": "date-time",
                  "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
                  "type": "string",
                },
                {
                  "type": "null",
                },
              ],
              "description": "When the block was unblocked; null while open.",
            },
            "unblockedBy": {
              "anyOf": [
                {
                  "anyOf": [
                    {
                      "const": "operator",
                      "type": "string",
                    },
                    {
                      "const": "system",
                      "type": "string",
                    },
                    {
                      "pattern": "^agent:[A-Za-z0-9._-]+\\/[A-Za-z0-9._-]+$",
                      "type": "string",
                    },
                  ],
                  "description": "Actor: operator, system, or agent:<project>/<session>.",
                },
                {
                  "type": "null",
                },
              ],
              "description": "Actor that unblocked the block; null while open.",
            },
          },
          "required": [
            "id",
            "task",
            "type",
            "state",
            "author",
            "addressee",
            "reason",
            "at",
            "outcome",
            "outcomeReason",
            "unblockedBy",
            "unblockedAt",
          ],
          "type": "object",
        },
      },
      "required": [
        "block",
      ],
      "type": "object",
    },
    "title": undefined,
