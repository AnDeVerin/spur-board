    },
    "description": "Ask the operator a question; the task is blocked until it is answered.
Use when: Ask a blocking question.
When not to use: Use comment_add for a nonblocking note.
Example: {"task":"PROJ-123","text":"Which API version should the client target?","idempotencyKey":"block_ask-example-001"}
Choose a unique idempotencyKey for each action; reuse it on retries.",
    "execution": undefined,
    "icons": undefined,
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "idempotencyKey": {
          "description": "Key to reuse when retrying this action.",
          "minLength": 1,
          "type": "string",
        },
        "task": {
          "description": "Task key: a Jira key (PROJ-123) or a GitHub issue (owner/repo#42, or repo#42).",
          "pattern": "^(?:[A-Za-z][A-Za-z0-9_]*-[1-9]\\d{0,14}|[A-Za-z0-9-]+\\/[A-Za-z0-9._-]+#[1-9]\\d{0,14}|[A-Za-z0-9._-]+#[1-9]\\d{0,14})$",
          "type": "string",
        },
        "text": {
          "description": "The question.",
          "minLength": 1,
          "type": "string",
        },
      },
      "required": [
        "task",
        "text",
      ],
      "type": "object",
    },
    "name": "block_ask",
    "outputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "block": {
          "additionalProperties": false,
          "description": "A block on a task.",
          "properties": {
            "addressee": {
              "description": "Who is expected to resolve the block.",
              "enum": [
                "operator",
                "orchestrator:todo",
                "orchestrator:ready-for-dev",
                "orchestrator:dev",
                "orchestrator:review",
                "orchestrator:qa",
                "orchestrator:ready-to-merge",
                "orchestrator:done",
                "worker",
              ],
              "type": "string",
            },
            "at": {
              "description": "When the block was opened, ISO 8601 UTC.",
              "format": "date-time",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
              "type": "string",
            },
            "author": {
              "anyOf": [
                {
                  "const": "operator",
                  "type": "string",
                },
                {
                  "const": "system",
                  "type": "string",
                },
                {
                  "pattern": "^agent:[A-Za-z0-9._-]+\\/[A-Za-z0-9._-]+$",
                  "type": "string",
                },
              ],
              "description": "Actor: operator, system, or agent:<project>/<session>.",
            },
            "id": {
              "description": "Block ID: B followed by a number, e.g. B12.",
              "pattern": "^B[1-9]\\d{0,14}$",
              "type": "string",
            },
            "outcome": {
              "anyOf": [
                {
                  "enum": [
                    "done",
                    "reason",
                    "terminal",
                    "withdrawn",
                    "archived",
                  ],
                  "type": "string",
                },
                {
                  "type": "null",
                },
              ],
              "description": "How the block was resolved; null while it is open.",
            },
            "outcomeReason": {
              "description": "Done reference or closure explanation; null when absent.",
              "type": [
                "string",
                "null",
              ],
            },
            "reason": {
              "description": "Why the task is blocked, or the question asked.",
              "type": "string",
            },
            "state": {
              "description": "Whether the block is open or unblocked.",
              "enum": [
                "open",
                "unblocked",
              ],
              "type": "string",
            },
            "task": {
              "description": "Task key: a Jira key (PROJ-123) or a GitHub issue (owner/repo#42, or repo#42).",
              "pattern": "^(?:[A-Za-z][A-Za-z0-9_]*-[1-9]\\d{0,14}|[A-Za-z0-9-]+\\/[A-Za-z0-9._-]+#[1-9]\\d{0,14}|[A-Za-z0-9._-]+#[1-9]\\d{0,14})$",
              "type": "string",
            },
            "type": {
              "description": "Block type.",
              "enum": [
                "code",
                "needs_input",
                "dependency",
                "external",
              ],
              "type": "string",
            },
            "unblockedAt": {
              "anyOf": [
                {
                  "format": "date-time",
                  "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
                  "type": "string",
                },
                {
                  "type": "null",
                },
              ],
              "description": "When the block was unblocked; null while open.",
            },
            "unblockedBy": {
              "anyOf": [
                {
                  "anyOf": [
                    {
                      "const": "operator",
                      "type": "string",
                    },
                    {
                      "const": "system",
                      "type": "string",
                    },
                    {
                      "pattern": "^agent:[A-Za-z0-9._-]+\\/[A-Za-z0-9._-]+$",
                      "type": "string",
                    },
                  ],
                  "description": "Actor: operator, system, or agent:<project>/<session>.",
                },
                {
                  "type": "null",
                },
              ],
              "description": "Actor that unblocked the block; null while open.",
            },
          },
          "required": [
            "id",
            "task",
            "type",
            "state",
            "author",
            "addressee",
            "reason",
            "at",
            "outcome",
            "outcomeReason",
            "unblockedBy",
            "unblockedAt",
          ],
          "type": "object",
        },
      },
      "required": [
        "block",
      ],
      "type": "object",
    },
    "title": undefined,
  },
