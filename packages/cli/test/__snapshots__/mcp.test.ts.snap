                },
                "type": "object",
              },
            },
            "required": [
              "id",
              "kind",
              "description",
              "grants",
              "errors",
              "cli",
              "mcp",
              "inputSchema",
              "outputSchema",
            ],
            "type": "object",
          },
          "type": "array",
        },
        "version": {
          "description": "Catalog version: sha256 hex of ops.snapshot.json; examples use a placeholder.",
          "pattern": "^[0-9a-f]{64}$",
