              "type": "string",
            },
            "state": {
              "description": "Whether the block is open or unblocked.",
              "enum": [
                "open",
                "unblocked",
              ],
              "type": "string",
            },
            "task": {
              "description": "Task key: a Jira key (PROJ-123) or a GitHub issue (owner/repo#42, or repo#42).",
              "pattern": "^(?:[A-Za-z][A-Za-z0-9_]*-[1-9]\\d{0,14}|[A-Za-z0-9-]+\\/[A-Za-z0-9._-]+#[1-9]\\d{0,14}|[A-Za-z0-9._-]+#[1-9]\\d{0,14})$",
              "type": "string",
            },
            "type": {
              "description": "Block type.",
              "enum": [
