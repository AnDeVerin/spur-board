    "description": "Submit the commit at the head of the task's pull request for a turn this session took; the turn closes.
Use when: Hand in the work of a turn you took, at the pull request head.
When not to use: Use task_return to send the task back to Dev instead.
Example: {"turn":"T4","sha":"9f2c4e1b7a3d5c8e0f1a2b3c4d5e6f708192a3b4","idempotencyKey":"task_submit-example-001"}
Choose a unique idempotencyKey for each action; reuse it on retries.",
    "execution": undefined,
    "icons": undefined,
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "idempotencyKey": {
          "description": "Key to reuse when retrying this action.",
          "minLength": 1,
          "type": "string",
        },
        "sha": {
          "description": "Full commit SHA at the head of the pull request, lowercase.",
          "pattern": "^[0-9a-f]{40,64}$",
          "type": "string",
        },
        "turn": {
          "description": "Turn ID: T followed by a number, e.g. T4.",
          "pattern": "^T[1-9]\\d{0,14}$",
          "type": "string",
        },
      },
      "required": [
        "turn",
        "sha",
      ],
      "type": "object",
    },
