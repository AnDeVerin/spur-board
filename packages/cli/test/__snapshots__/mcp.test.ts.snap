// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`board mcp > lists one catalog tool with schemas, guidance and annotations per operation 1`] = `
[
  {
    "description": "List items, freshness, service health, host metrics, tasks with columnEnteredAt, turns and PRs; detail adds facts.
Use when: Get a board overview.
When not to use: Use task_get for one task.
Example: {}",
    "name": "status_get",
  },
  {
    "description": "Show a task; refresh reads GitHub PRs.
Use when: Inspect a task; detail adds closed turns.
When not to use: Use task_history for past events.
Example: {"task":"PROJ-123"}",
    "name": "task_get",
  },
  {
    "description": "List what happened to a task, oldest first by time, leaving out facts events with nothing new to name, such as an update time alone.
Use when: Trace changes to one task.
When not to use: Use task_get for current state.
Example: {"task":"acme/web#42"}",
    "name": "task_history",
  },
  {
    "description": "Describe the operations: inputs, outputs, errors and bindings.
Use when: Discover operation contracts.
When not to use: Use status_get for board data.
Example: {"role":"worker"}",
    "name": "schema_get",
  },
  {
    "description": "List the comments, blocks and turns addressed to the caller and not yet handled.
Use when: Read items awaiting the caller.
When not to use: Use inbox_ack to mark them read.
Example: {}",
    "name": "inbox_get",
  },
  {
    "description": "List what waits for the operator and what was handled in the last 24 hours; a project's own operator session sees only its operator projects, and _board entries go to the operator token, the board-wide operator, or the operator of a one-project board without a board-wide operator.
Use when: As the operator, review every open operator item, block and turn across projects in one list.
When not to use: Use inbox_get for the comments, blocks and turns addressed to an agent.
Example: {}",
    "name": "inbox_operator",
  },
  {
    "description": "Mark comments, agent-addressed blocks, turns or doorbell rings as read; acking a turn makes the caller its taker.
Use when: Mark handled inbox items or a ring ID like N18-1 read; an item handled before comes back under alreadyHandled. The operator acks a turn ID to take a turn addressed to the operator, or to take over an open orchestrator turn, taken or not.
When not to use: Use inbox_get to inspect them first; the operator finds the turns addressed to it with inbox_operator.
Example: {"entries":[{"id":"C3","revision":1}],"idempotencyKey":"inbox_ack-example-001"}
Choose a unique idempotencyKey for each action; reuse it on retries.",
    "name": "inbox_ack",
  },
  {
    "description": "List named operator tokens with their status and when each was created, approved and last used.
Use when: Inspect named operator tokens, their status, and when each was approved and last used.
When not to use: Use token_revoke to disable a token.
Example: {}",
    "name": "token_list",
  },
  {
    "description": "Revoke a named operator token immediately.
Use when: Disable a named operator token immediately.
When not to use: Use token_list to inspect tokens without changing them.
Example: {"name":"desk","idempotencyKey":"token_revoke-example-001"}
Choose a unique idempotencyKey for each action; reuse it on retries.",
    "name": "token_revoke",
  },
  {
    "description": "Put a tracker task on the board.
Use when: Add a task to the board.
When not to use: Use task_get if it already exists.
Example: {"task":"PROJ-123","idempotencyKey":"task_add-example-001"}
Choose a unique idempotencyKey for each action; reuse it on retries.",
    "name": "task_add",
  },
  {
    "description": "Take a task off the board.
Use when: Remove a task from active view.
When not to use: Use task_get to inspect its current state.
Example: {"task":"PROJ-123","idempotencyKey":"task_archive-example-001"}
Choose a unique idempotencyKey for each action; reuse it on retries.",
    "name": "task_archive",
  },
  {
    "description": "Manually link a pull request, session, or additional ticket to a task. Pull request links first read current facts from GitHub.
Use when: Attach a pull request, session, or additional ticket.
When not to use: Use link_remove to detach one.
Example: {"mode":"pr","task":"PROJ-123","pr":"https://github.com/example/web/pull/7","reason":"Attach work started before the ticket was named.","idempotencyKey":"link_add-example-001"}
Choose a unique idempotencyKey for each action; reuse it on retries.",
    "name": "link_add",
  },
  {
    "description": "Manually remove a pull request, session, or ticket link from a task.
Use when: Detach a linked pull request, session, or ticket.
When not to use: Use link_add to attach one.
Example: {"mode":"session","task":"PROJ-123","session":"web-7","reason":"Wrong task.","idempotencyKey":"link_remove-example-001"}
Choose a unique idempotencyKey for each action; reuse it on retries.",
    "name": "link_remove",
  },
  {
    "description": "Retry the action behind a "from you" item.
Use when: Retry an actionable item.
When not to use: Use item_close when no retry is wanted.
Example: {"item":"I7","idempotencyKey":"item_retry-example-001"}
Choose a unique idempotencyKey for each action; reuse it on retries.",
    "name": "item_retry",
  },
  {
    "description": "Close a "from you" item without retrying; some block items close their block.
Use when: Dismiss an item without retrying. An anomaly, cycle_limit or course_check item also closes its block; an operator-block: item closes its block when you may unblock it.
When not to use: Use item_retry to try again.
Example: {"item":"I8","idempotencyKey":"item_close-example-001"}
Choose a unique idempotencyKey for each action; reuse it on retries.",
    "name": "item_close",
  },
  {
    "description": "Ask a blocking question; the Board routes it to the column orchestrator, the curator or the operator.
Use when: Ask a blocking question.
When not to use: Use comment_add for a nonblocking note.
Example: {"task":"PROJ-123","text":"Which API version should the client target?","idempotencyKey":"block_ask-example-001"}
Choose a unique idempotencyKey for each action; reuse it on retries.",
    "name": "block_ask",
  },
  {
    "description": "Ask the operator about a project, not a task.
Use when: A question has no task.
When not to use: Use block_ask for a task question.
Example: {"project":"web","to":"operator","text":"Restart?","idempotencyKey":"project_ask-example-001"}
Choose a unique idempotencyKey for each action; reuse it on retries.",
    "name": "project_ask",
  },
  {
    "description": "Comment on a task.
Use when: Add a new task comment.
When not to use: Use comment_edit to revise your comment.
Example: {"task":"PROJ-123","text":"Target v2.","idempotencyKey":"comment_add-example-001"}
Choose a unique idempotencyKey for each action; reuse it on retries.",
    "name": "comment_add",
  },
  {
    "description": "Edit a comment written by the caller; the revision advances.
Use when: Revise your existing comment.
When not to use: Use comment_add for a new comment.
Example: {"comment":"C3","text":"Target v3.","idempotencyKey":"comment_edit-example-001"}
Choose a unique idempotencyKey for each action; reuse it on retries.",
    "name": "comment_edit",
  },
  {
    "description": "Block a task on a dependency or an external party.
Use when: Record a dependency or external block.
When not to use: Use block_ask for a question.
Example: {"task":"PROJ-123","type":"dependency","reason":"Needs PROJ-120 merged first.","idempotencyKey":"block_create-example-001"}
Choose a unique idempotencyKey for each action; reuse it on retries.",
    "name": "block_create",
  },
  {
    "description": "Pass a block on to the next addressee up the chain.
Use when: Escalate an open block.
When not to use: Use block_answer to answer a question.
Example: {"block":"B13","idempotencyKey":"block_escalate-example-001"}
Choose a unique idempotencyKey for each action; reuse it on retries.",
    "name": "block_escalate",
  },
  {
    "description": "Answer a question; the block closes unless it is an operator conversation.
Use when: Answer an open question.
When not to use: Use block_unblock to close without an answer.
Example: {"block":"B12","text":"Target v2.","idempotencyKey":"block_answer-example-001"}
Choose a unique idempotencyKey for each action; reuse it on retries.",
    "name": "block_answer",
  },
  {
    "description": "Follow up on an unblocked block: the comment rings its author like an answer; the block stays closed.
Use when: Add to an answer after the block was unblocked.
When not to use: Use block_answer while the block is open.
Example: {"block":"B12","text":"Also check v3.","idempotencyKey":"block_followup-example-001"}
Choose a unique idempotencyKey for each action; reuse it on retries.",
    "name": "block_followup",
  },
  {
    "description": "Close a block: the work is done, a reason is given, or its author withdraws it.
Use when: Close an open block.
When not to use: Use block_answer for a question answer.
Example: {"mode":"done","block":"B13","ref":"example/web#9","idempotencyKey":"block_unblock-example-001"}
Choose a unique idempotencyKey for each action; reuse it on retries.",
    "name": "block_unblock",
  },
  {
    "description": "Submit the task's pull request head for a turn the caller took; the turn closes; a pending result is final.
Use when: Hand in the work of a turn you took, at the pull request head. Declare tested (default), carried from a tested origin on this task, or skipped; carried requires from and reason, skipped requires reason. While the project dispatcher is in shadow mode no turn opens: the column executor submits with the task key.
When not to use: Use task_return to send the task back to Dev instead.
Example: {"turn":"T4","sha":"9f2c4e1b7a3d5c8e0f1a2b3c4d5e6f708192a3b4","idempotencyKey":"task_submit-example-001"}
Choose a unique idempotencyKey for each action; reuse it on retries.",
    "name": "task_submit",
  },
  {
    "description": "Return the task of a turn the caller took to Dev; the reason opens a worker code block.
Use when: Send the task back to Dev when the work needs code changes.
When not to use: Use task_submit to hand in the work instead.
Example: {"turn":"T4","reason":"Handle the empty list in the parser.","idempotencyKey":"task_return-example-001"}
Choose a unique idempotencyKey for each action; reuse it on retries.",
    "name": "task_return",
  },
  {
    "description": "Wait on a turn the caller took for an outside condition; the Board stays quiet, then rings the holder when the wait ends. The operator can end the active wait early.
Use when: You hold a turn. Wait only on a condition you cannot change and must re-check: a busy test stand, no free slot, high machine load, a deploy, an outside service. Give whole minutes and the reason; the Board rings you with the reason when the wait ends, and submit, return or a close ends it earlier. Waits per turn are capped by count and total time. As the operator, pass end to end a holder's active wait early; the holder is rung.
When not to use: Use task_submit to hand in finished work, or task_return to send the task back to Dev. Not on your own work (review fixes, tests, checks, rebasing): work holding the turn, so a stall reaches the operator; a wait hides it.
Example: {"turn":"T4","for":30,"reason":"waiting for a free test stand","idempotencyKey":"task_wait-example-001"}
Choose a unique idempotencyKey for each action; reuse it on retries.",
    "name": "task_wait",
  },
  {
    "description": "Move an idle task inside the Todo group, or correct its column and settle the gates.
Use when: Place idle work at the end of an enabled Todo-group column with a literal reason and explicit key, or correct a wrong column with mode correct.
When not to use: Use task_get with why to read why the task is where it is.
Example: {"mode":"manual","task":"PROJ-123","column":"ready-for-dev","reason":"Ready for the next worker.","idempotencyKey":"task_move-example-001"}
Choose a unique idempotencyKey for each action; reuse it on retries.",
    "name": "task_move",
  },
  {
    "description": "Place a task before or after another task, or at the top or bottom of its column order; exactly one placement (\`--before\`, \`--after\`, \`--top\` or \`--bottom\`) and a non-blank key are required, else \`usage\`.
Use when: The operator wants a task earlier or later among the tasks of its column; pass an explicit key. Each column has one order for the whole board.
When not to use: Use task_move to change the column.
Example: {"mode":"before","task":"PROJ-123","anchor":"PROJ-120","idempotencyKey":"task_order-example-001"}
Choose a unique idempotencyKey for each action; reuse it on retries.",
    "name": "task_order",
  },
  {
    "description": "Show effective project columns, executors, Spur bindings and web origins.
Use when: Read configuration before rendering the Board overview.
When not to use: Use status_get for task state and freshness.
Example: {}",
    "name": "config_get",
  },
  {
    "description": "Describe effective column exit rules, returns, executors and escalation.
Use when: Read the project column policy before deciding how to progress work; selected sessions are project-level choices, not task-specific recipients.
When not to use: Use task_get with why for a task’s current gates and turn, or config_get for compact bindings and web origins.
Example: {"project":"web"}",
    "name": "columns_describe",
  },
]
`;
