{
  "name": "spur-board",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "bin": {
    "board": "./src/bin.mjs"
  },
  "exports": {
    ".": "./src/client.ts"
  },
  "publishConfig": {
    "bin": {
      "board": "./dist/bin.mjs"
    },
    "exports": {
      ".": "./dist/client.mjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit -p .",
    "build": "tsdown",
    "prepack": "pnpm run build"
  },
  "dependencies": {
    "@commander-js/extra-typings": "catalog:",
    "@modelcontextprotocol/server": "catalog:",
    "commander": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "catalog:",
    "@spur-board/contracts": "workspace:*",
    "tsdown": "catalog:"
  }
}
