{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreFiles": ["packages/*/test/lint-fixtures/**", "design/**"],
  "ignoreDependencies": ["conventional-changelog-conventionalcommits"],
  "ignoreBinaries": ["flock", "systemd-notify", "systemd-analyze"],
  "workspaces": {
    "packages/web": {
      "entry": [
        "test/**/*.test.ts",
        "src/ds/index.ts",
        "src/ds/*/*.examples.tsx",
        "gallery/main.tsx",
        "kit/entry.ts"
      ],
      "project": ["src/**/*.{ts,tsx}", "test/**/*.ts", "gallery/**/*.{ts,tsx}", "kit/**/*.ts"]
    }
  }
}
